# ---- Serveur ----
PORT=3000
SITE_NAME=ChatNow
SITE_URL=https://exemple.fr
# Mettre 1 uniquement si le site est derrière Nginx / OpenLiteSpeed / Cloudflare,
# sinon toutes les IP seraient identiques et un bannissement mettrait tout le monde dehors.
TRUST_PROXY=0

# ---- Base de données (MySQL / MariaDB) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chat
DB_PASSWORD=
DB_NAME=chatnow

# ---- Sécurité ----
# Obligatoire. À générer avec :  openssl rand -hex 32
APP_SECRET=
# Mot de passe du panneau /admin
ADMIN_PASSWORD=

# ---- Modération ----
MAX_MESSAGE_LENGTH=500
FLOOD_WINDOW_MS=10000
FLOOD_MAX_MESSAGES=5
FLOOD_MUTE_SECONDS=30
BLOCK_LINKS=1
LINK_WHITELIST=
BLOCK_CONTACT_DETAILS=1
MIN_AGE=15
MAX_AGE=99

# ---- Vie privée ----
RETENTION_DAYS=30
HISTORY_MESSAGES=50
SESSION_DAYS=7
