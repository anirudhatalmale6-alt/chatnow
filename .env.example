# ---- Serveur ----
PORT=3000
SITE_NAME=ChatNow
SITE_URL=https://exemple.fr
# Mettre 1 uniquement si le site est derrière Nginx / OpenLiteSpeed / Cloudflare,
# sinon toutes les IP seraient identiques et un bannissement mettrait tout le monde dehors.
TRUST_PROXY=0

# ---- Base de données (MySQL / MariaDB) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chat
DB_PASSWORD=
DB_NAME=chatnow

# ---- Sécurité ----
# Obligatoire. À générer avec :  openssl rand -hex 32
APP_SECRET=
# Mot de passe du panneau /admin
ADMIN_PASSWORD=

# ---- Modération ----
MAX_MESSAGE_LENGTH=500
FLOOD_WINDOW_MS=10000
FLOOD_MAX_MESSAGES=5
FLOOD_MUTE_SECONDS=30
BLOCK_LINKS=1
LINK_WHITELIST=
BLOCK_CONTACT_DETAILS=1
MIN_AGE=15
MAX_AGE=99

# ---- Salons micro (WebRTC) ----
# Nombre maximum de personnes au micro EN MÊME TEMPS dans un salon audio.
# Le son ne passe pas par le serveur : chacun envoie son flux à tous les
# autres, donc c'est la connexion des participants qui limite, pas la machine.
VOICE_MAX_SPEAKERS=8
# Serveurs STUN, séparés par des virgules. Ils servent uniquement à ce que deux
# navigateurs derrière des box se trouvent ; aucun son n'y transite.
ICE_SERVERS=stun:stun.l.google.com:19302
# Serveur TURN, nécessaire seulement si des visiteurs sont derrière un réseau
# très fermé (entreprise, certains opérateurs mobiles). Là, le son transite.
# ICE_SERVERS=stun:stun.l.google.com:19302,turn:turn.mondomaine.fr:3478
# TURN_USER=
# TURN_PASSWORD=

# ---- Vie privée ----
RETENTION_DAYS=30
HISTORY_MESSAGES=50
SESSION_DAYS=7
